---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { HeroEntry } from "../components/hero";
import { ConfirmTile, CustomTile, InventoryTile, SessionTile, StatTile, StatementTile, WallTile } from "../components/tiles";

const features = (await getCollection("features"))[0]?.data;
if (!features) throw new Error("src/content/features.json is missing or failed its schema");
const releases = (await getCollection("releases")).sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 3);
---
<Base title="StrapSheets" description="Strap sheets for drilling tools, filled in on the phone and emailed as a PDF.">
  <section class="hero-copy">
    <div>
      <h1>Strap sheets, on the phone.</h1>
      <p class="lede">A directional driller measures the tool once. StrapSheets draws the card and hands a PDF to the mail app already on the phone. The office prints that card and sorts it on the wall.</p>
      <div class="claims">
        {features.headlines.map((item) => (
          <div><strong>{item.title}</strong><span>{item.text}</span></div>
        ))}
      </div>
    </div>
    <HeroEntry client:only="react" />
  </section>

  <h2>The sheet, not the paper</h2>
  <div class="bento">
    <figure class="tile span2">
      <ConfirmTile client:only="react" />
      <figcaption><strong>The letter stays lit.</strong> The measure you are on is the one the drawing marks.</figcaption>
    </figure>
    <figure class="tile">
      <StatTile client:only="react" />
      <figcaption><strong>The whole list.</strong> Twelve standard tools, the carrier, and Custom.</figcaption>
    </figure>
    <figure class="tile">
      <SessionTile client:only="react" />
      <figcaption><strong>Tick and send.</strong> Today’s sheets, then your own mail app.</figcaption>
    </figure>
    <figure class="tile">
      <WallTile client:only="react" />
      <figcaption><strong>Sorted by family.</strong> One size, so a paper set hangs in order.</figcaption>
    </figure>
    <figure class="tile">
      <StatementTile client:only="react" />
      <figcaption><strong>Typed the way the yard talks.</strong> Serials stay in capitals.</figcaption>
    </figure>
  </div>

  <section class="section">
    <h2>On the wall</h2>
    <p>The phone, the mail, and the printout are the same card. Grey labels, a yellow metric block, the family under it. Nothing is retyped to make it fit a binder.</p>
    <div class="bento">
      <figure class="tile span2">
        <WallTile id="tile-wall-page" client:only="react" />
        <figcaption><strong>Pin the top card.</strong> The family and the job are the words. The rest of the pile is the set.</figcaption>
      </figure>
      <figure class="tile">
        <CustomTile client:only="react" />
        <figcaption><strong>Custom is Pro</strong> on the phone. The web sheet keeps it open.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <h2>On-site inventory</h2>
    <p>Coming. Pick a serial from the stock on location, and see the tools assigned to the job, instead of copying them off a paper list.</p>
    <figure class="tile">
      <InventoryTile client:only="react" />
    </figure>
  </section>

  <section class="section">
    <h2>What’s new</h2>
    {releases.length === 0 ? <p>Release notes land here with each store build.</p> : releases.map((entry) => (
      <article class="release">
        <strong>{entry.data.version}</strong>
        <span> · {entry.data.date} · {entry.data.platforms.join(" and ")}</span>
        <p>{entry.data.notes}</p>
      </article>
    ))}
    <p><a href="/releases">All releases</a></p>
  </section>
</Base>
