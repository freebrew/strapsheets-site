---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { BhaPreview } from "../components/bha";
import { WEB_APP_URL } from "../site";

const features = (await getCollection("features"))[0]?.data;
if (!features) throw new Error("src/content/features.json is missing or failed its schema");
const latest = (await getCollection("releases")).sort(
  (a, b) => b.data.version.localeCompare(a.data.version, undefined, { numeric: true }) || b.data.date.localeCompare(a.data.date),
)[0];
---
<Base title="StrapSheets" description="Strap sheets for drilling tools, filled in on the phone and emailed as a PDF." page="home">
  <section class="feature-grid-section" aria-label="Technical Feature Grid">
    <div class="feature-grid-header">
      <span class="fg-coord">GRID // 01–05 · CONSOLE FIELD &amp; OFFICE WORKFLOW</span>
      <h2>Built For The Rig Floor, The BHA Sheet, and The Office Wall.</h2>
    </div>

    <div class="landing">
      <div class="landing-quad">
        <div class="tile tile--copy">
          <div class="hero-coord-badge">CONSOLE · FIELD &amp; OFFICE STRAP SHEETS</div>
          <h1>Strap sheets, on the phone</h1>
          <p class="lede">A directional driller measures the tool once. StrapSheets highlights the callout on the steel drawing, configures BOX and PIN ends in one step each, and hands a print-ready PDF to the mail app on the phone.</p>
          <p class="cta-row">
            <a class="button primary" href={WEB_APP_URL} target="_blank" rel="noopener">Open The Web Version</a>
            <a class="button" href="/releases">Releases{latest ? ` · v${latest.data.version}` : ""}</a>
          </p>
          <div class="claims">
            {features.headlines.map((item) => (
              <div><strong>{item.title}</strong><span>{item.text}</span></div>
            ))}
          </div>
          <p class="latest">
            <strong>Latest release</strong> ·
            {latest ? (
              <span>
                <strong>v{latest.data.version}</strong>{latest.data.webRev ? ` (${latest.data.webRev})` : ""} · {latest.data.date} — {latest.data.title ?? latest.data.notes}
              </span>
            ) : (
              <span>Release notes land here with each store build.</span>
            )}
            · <a href="/releases">Release Summary</a>
          </p>
        </div>

        <figure class="tile tile--entry">
          <div class="cell cell--film"><video class="loop-film" src="/loops/entry.mp4" poster="/loops/entry-poster.png" autoplay muted loop playsinline></video></div>
          <figcaption><strong>Data Entry.</strong> Tool, serial, material, BOX and PIN, one measure, then the card.</figcaption>
        </figure>

        <figure class="tile tile--sessions">
          <div class="cell cell--film"><video class="loop-film" src="/loops/sessions.mp4" poster="/loops/sessions-poster.png" autoplay muted loop playsinline></video></div>
          <figcaption><strong>Sessions.</strong> Several PDFs, then Select, Inverse, a date range, and Delete.</figcaption>
        </figure>

        <figure class="tile tile--settings">
          <div class="cell cell--film"><video class="loop-film" src="/loops/settings.mp4" poster="/loops/settings-poster.png" autoplay muted loop playsinline></video></div>
          <figcaption><strong>Settings.</strong> Jobs, email addresses, and thread names, with Select, Inverse, Delete, and a date range.</figcaption>
        </figure>
      </div>

      <div class="landing-side">
        <figure class="tile tile--bha">
          <div class="cell" data-ss-fill data-ss-wide><BhaPreview client:only="react" /></div>
        </figure>
        <figure class="tile tile--sheets">
          <div class="cell cell--film"><video class="loop-film loop-film--fan" src="/loops/sheets.mp4?v=2" poster="/loops/sheets-poster.png?v=2" autoplay muted loop playsinline></video></div>
          <figcaption><strong>Print Sheets.</strong> Six strap-sheet pages fan out for the wall.</figcaption>
        </figure>
      </div>
    </div>
  </section>
  <script is:inline>
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.querySelectorAll("video.loop-film").forEach((video) => {
        video.removeAttribute("autoplay");
        video.pause();
      });
    }
  </script>
</Base>
