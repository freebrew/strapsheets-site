---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { HeroEntry } from "../components/hero";
import { ConfirmTile, InventoryTile, SessionTile, WallTile } from "../components/tiles";
import { WEB_APP_URL } from "../site";

const features = (await getCollection("features"))[0]?.data;
if (!features) throw new Error("src/content/features.json is missing or failed its schema");
const latest = (await getCollection("releases")).sort((a, b) => b.data.date.localeCompare(a.data.date))[0];
---
<Base title="StrapSheets" description="Strap sheets for drilling tools, filled in on the phone and emailed as a PDF." page="home">
  <section class="hero-copy">
    <div class="copy">
      <h1>Strap sheets, on the phone.</h1>
      <p class="lede">A directional driller measures the tool once. StrapSheets draws the card and hands a PDF to the mail app already on the phone. The office prints that card and sorts it on the wall.</p>
      <p class="cta-row">
        <a class="button primary" href={WEB_APP_URL} target="_blank" rel="noopener">Open the Web Version</a>
        <a class="button" href="/how">How It Works</a>
      </p>
      <div class="claims">
        {features.headlines.map((item) => (
          <div><strong>{item.title}</strong><span>{item.text}</span></div>
        ))}
      </div>
      <p class="latest">
        <strong>What’s new</strong> ·
        {latest ? <span>{latest.data.version} · {latest.data.date}</span> : <span>Release notes land here with each store build.</span>}
        · <a href="/releases">All Releases</a>
      </p>
    </div>
    <div class="hero-stage"><HeroEntry client:only="react" /></div>
  </section>

  <div class="strip">
    <figure class="tile">
      <div class="cell"><ConfirmTile client:only="react" /></div>
      <figcaption><strong>The letter stays lit.</strong> The measure you are on is the one the drawing marks.</figcaption>
    </figure>
    <figure class="tile">
      <div class="cell"><SessionTile client:only="react" /></div>
      <figcaption><strong>Tick and send.</strong> Today’s sheets, then your own mail app.</figcaption>
    </figure>
    <figure class="tile">
      <div class="cell"><WallTile client:only="react" /></div>
      <figcaption><strong>Sorted by family.</strong> One size, so a paper set hangs in order on the wall.</figcaption>
    </figure>
    <figure class="tile">
      <div class="cell"><InventoryTile client:only="react" /></div>
      <figcaption><strong>On-site inventory, coming.</strong> Pick a serial from the stock on location.</figcaption>
    </figure>
  </div>
</Base>
