---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { CustomTile, HowPair, InventoryTile, SessionTile, StatTile, StatementTile } from "../components/tiles";

const features = (await getCollection("features"))[0]?.data;
if (!features) throw new Error("src/content/features.json is missing or failed its schema");
---
<Base title="How StrapSheets works" description="The path from a measurement to a PDF, and the tools on the sheet.">
  <h1>How it works</h1>
  <HowPair client:only="react" />
  <ol>
    <li>Pick the job number and the tool.</li>
    <li>Enter the serial, the ends, the threads, and the measurements the sheet asks for.</li>
    <li>Confirm the card. The phone draws the PDF on the device.</li>
    <li>Send opens your mail app with the PDF attached. You press Send there.</li>
  </ol>
  <h2>The tools</h2>
  <ul class="tools">
    {features.tools.map((tool) => (
      <li class={tool.kind === "custom" ? "pro" : undefined}>{tool.name}{tool.kind === "custom" ? " · Pro on the phone" : ""}</li>
    ))}
  </ul>
  <h2>On the sheet</h2>
  <div class="bento">
    <figure class="tile">
      <StatTile client:only="react" />
      <figcaption><strong>The whole list.</strong> Twelve standard tools, the carrier, and Custom.</figcaption>
    </figure>
    <figure class="tile">
      <StatementTile client:only="react" />
      <figcaption><strong>Typed the way the yard talks.</strong> Serials stay in capitals.</figcaption>
    </figure>
    <figure class="tile">
      <CustomTile client:only="react" />
      <figcaption><strong>Custom is Pro</strong> on the phone. The web sheet keeps it open.</figcaption>
    </figure>
    <figure class="tile">
      <SessionTile client:only="react" />
      <figcaption><strong>Tick and send.</strong> Today’s sheets, then your own mail app.</figcaption>
    </figure>
    <figure class="tile">
      <InventoryTile client:only="react" />
      <figcaption><strong>On-site inventory, coming.</strong> Pick a serial from the stock on location.</figcaption>
    </figure>
  </div>
</Base>
